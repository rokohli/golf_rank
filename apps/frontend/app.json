{
  "expo": {
    "name": "GolfRank",
    "slug": "golf-rank",
    "version": "1.0.0",
    "scheme": "golfrank",
    "ios": {
      "bundleIdentifier": "com.rokohli.golfrank.dev"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-asset",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow GolfRank to let you choose a guest from your contacts."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GolfRank to use your location to find nearby golf courses."
        }
      ]
    ]
  }
}
